@page "/"
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Welkom bij TaalMaat</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center" Style="height: 100vh;">
    <MudPaper Elevation="5" Class="pa-10 text-center" Style="border-radius:24px; width:100%;">
        <MudIcon Icon="@Icons.Material.Filled.Language" Color="Color.Primary" Style="font-size:6rem;" Class="mb-4" />
        <MudText Typo="Typo.h3" Color="Color.Primary" Class="mb-4 fw-bold">TaalMaat</MudText>
        <MudText Typo="Typo.h6" Class="mb-6 mud-text-secondary">Samen Nederlands spreken, samen groeien!</MudText>

        @if (_isLaden)
        {
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="mb-6"/>
            <MudText Typo="Typo.body1">Bezig met laden...</MudText>
        }
    </MudPaper>
</MudContainer>

@code {
    private bool _isLaden = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            if (user.IsInRole("Admin"))
            {
                Navigation.NavigateTo("/admin", forceLoad: true);
            }
            else if (user.IsInRole("Vrijwilliger"))
            {
                Navigation.NavigateTo("/volunteer", forceLoad: true);
            }
            else if (user.IsInRole("Anderstalig"))
            {
                Navigation.NavigateTo("/student", forceLoad: true);
            }
            else
            {
                Navigation.NavigateTo("/profiel", forceLoad: true);
            }
        }
        else
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}
