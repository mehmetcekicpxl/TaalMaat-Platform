@page "/student/sessies"
@attribute [Authorize(Roles = "Anderstalig")]
@inject SessieService SessieService
@inject JitsiService JitsiService
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration
@inject CalendarService CalendarService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
<PageTitle>Mijn Sessies – TaalMaat</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Mijn geplande sessies</MudText>
<MudText Typo="Typo.subtitle1" Class="mb-6 mud-text-secondary">
    Aankomende videogesprekken met uw vrijwilliger(s).
</MudText>

@if (_sessies == null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!_sessies.Any())
{
    <MudPaper Elevation="2" Class="pa-8 text-center" Style="border-radius: 20px;">
        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Default" Style="font-size:5rem;" Class="mb-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Nog geen sessies gepland</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Uw vrijwilliger kan een videogesprek voor u plannen.
        </MudText>
        <MudButton Href="/student" Variant="Variant.Filled" Color="Color.Primary">
            Terug naar dashboard
        </MudButton>
    </MudPaper>
}
else
{
    @foreach (var sessie in _sessies.OrderBy(s => s.GeplandOp))
    {
        var aanloopMinuten = Configuration.GetValue<int>("VideoActivationLeadTimeMinutes", 10);
        var videoActief = JitsiService.IsVideoButtonActief(sessie.GeplandOp, aanloopMinuten);
        var isVerleden = sessie.GeplandOp < DateTime.UtcNow;

        <MudCard Elevation="4" Class="mb-5" Style="@(isVerleden ? "border-left: 6px solid #9e9e9e;" : videoActief ? "border-left: 6px solid #4caf50; background: linear-gradient(135deg, #f1f8e9 0%, #ffffff 100%);" : "border-left: 6px solid #1976D2;")">
            <MudCardContent>
                <MudGrid AlignItems="AlignItems.Center">
                    <MudItem xs="12" sm="7">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <!-- Status indicator -->
                            <div style="text-align:center;">
                                @if (isVerleden)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Default" Style="font-size:3rem;" />
                                    <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">Afgelopen</MudText>
                                }
                                else if (videoActief)
                                {
                                    <div style="animation: pulse 1.5s infinite;">
                                        <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Color="Color.Success" Style="font-size:1.5rem;" />
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Success"><strong>LIVE</strong></MudText>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Primary" Style="font-size:3rem;" />
                                    <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">Gepland</MudText>
                                }
                            </div>

                            <div>
                                <MudText Typo="Typo.h6">
                                     Videogesprek met @(sessie.Vrijwilliger.VolledigeNaam ?? "uw vrijwilliger")
                                </MudText>
                                <MudText Typo="Typo.body1" Class="mt-1">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-1" />
                                    @sessie.GeplandOp.ToLocalTime().ToString("dddd d MMMM yyyy")
                                </MudText>
                                <MudText Typo="Typo.body1">
                                    <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Class="mr-1" />
                                    @sessie.GeplandOp.ToLocalTime().ToString("HH:mm") uur
                                </MudText>

                                @if (!isVerleden && !videoActief)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                                        Video beschikbaar @aanloopMinuten min. vóór aanvang
                                    </MudText>
                                }
                            </div>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" sm="5">
                        <MudStack Spacing="2">
                            @if (!isVerleden)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="@(videoActief ? Color.Success : Color.Default)"
                                           Href="@(videoActief ? sessie.JitsiUrl : "#")"
                                           Target="_blank"
                                           Disabled="@(!videoActief)"
                                           FullWidth="true"
                                           Size="Size.Large"
                                           Style="@(videoActief ? "min-height:60px; font-size:1.1rem; animation: glow 2s infinite;" : "min-height:60px;")"
                                           StartIcon="@Icons.Material.Filled.VideoCall">
                                    @if (videoActief)
                                    {
                                        <span>🟢 Nu Deelnemen!</span>
                                    }
                                    else
                                    {
                                        <span> Video Nog Niet Actief</span>
                                    }
                                </MudButton>

                                <!-- Kalender download -->
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.CalendarMonth"
                                           OnClick="() => DownloadKalender(sessie)">
                                    Toevoegen aan Agenda
                                </MudButton>
                                
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           OnClick="() => AnnuleerSessie(sessie)">
                                    Sessie Annuleren
                                </MudButton>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default">Sessie afgerond</MudChip>
                            }
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
    }
}

<style>
    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.4; }
        100% { opacity: 1; }
    }
    @@keyframes glow {
        0% { box-shadow: 0 0 5px #4caf50; }
        50% { box-shadow: 0 0 20px #4caf50; }
        100% { box-shadow: 0 0 5px #4caf50; }
    }
</style>

@code {
    private List<Sessie>? _sessies;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
            _sessies = (await SessieService.GetSessiesVanAnderstaligAsync(userId)).ToList();
    }

    private async Task DownloadKalender(Sessie sessie)
    {
        var aanloopMinuten = Configuration.GetValue<int>("VideoActivationLeadTimeMinutes", 10);
        var icsInhoud = CalendarService.GenereerIcs(
            "TaalMaat Videogesprek met uw Buddy",
            sessie.GeplandOp.ToLocalTime(), 
            sessie.GeplandOp.ToLocalTime().AddHours(1),
            "Videogesprek via https://meet.ffmuc.net",
            $"Log in op het TaalMaat platform om deel te nemen aan het gesprek. De videoknop wordt {aanloopMinuten} minuten voor aanvang actief."
        );

        var bytes = System.Text.Encoding.UTF8.GetBytes(icsInhoud);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("taalmaat.downloadFileFromBase64", "taalmaat-sessie.ics", base64, "text/calendar");
    }

    private async Task AnnuleerSessie(Sessie sessie)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Sessie Annuleren", 
            $"Weet u zeker dat u de sessie van {sessie.GeplandOp.ToLocalTime():dd/MM/yyyy HH:mm} wilt annuleren?", 
            yesText: "Ja, annuleer", cancelText: "Nee");
            
        if (confirmed == true)
        {
            await SessieService.VerwijderSessieAsync(sessie.Id);
            Snackbar.Add("De sessie is succesvol geannuleerd.", Severity.Info);
            // Herlaad
            _sessies = (await SessieService.GetSessiesVanAnderstaligAsync(_sessies.First().AnderstaligId)).ToList();
        }
    }
}
